# Configuración de variables de entorno para el Sistema de Torneos
# Copiar este archivo como .env para desarrollo local: `cp .env.example .env`

# Puerto en el que corre la aplicación Next.js
PORT=3000

# Entorno de ejecución
NODE_ENV=development

# Nombre de la aplicación
NEXT_PUBLIC_APP_NAME="Sistema de Torneos Deportivos"
